{
  "name": "personal-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-route.ts && vite dev",
    "build": "node scripts/generate-route.ts && vite build && node scripts/upload-posthog-sourcemaps.ts",
    "preview": "bun run build && wrangler dev",
    "generate:route": "node scripts/generate-route.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-main-module=false"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "posthog-js": "^1.368.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@posthog/cli": "^0.20.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.19.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.166.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
